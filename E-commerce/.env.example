# Shopro backend environment variables.
# Spring Boot does not read .env files by itself: export them in your shell
#   set -a; source .env; set +a; ./mvnw spring-boot:run
# or configure them in your IDE run configuration / systemd EnvironmentFile.

# dev = admin/admin123 + demo accounts, verbose logs; prod = strict (all secrets required)
SPRING_PROFILES_ACTIVE=dev

# --- Database (SQL Server) ---
DB_URL=jdbc:sqlserver://localhost:1433;DatabaseName=e-commerce;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=change-me

# --- JWT: base64, >= 32 bytes. Generate with: openssl rand -base64 32 ---
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Initial admin (only used when the users table is empty) ---
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=
# manager/staff/customer demo accounts with well-known passwords (dev only!)
DEMO_USERS=false

# --- Google sign-in (same client ID as frontend VITE_GOOGLE_CLIENT_ID; empty = disabled) ---
GOOGLE_CLIENT_ID=

# --- URLs ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
STOREFRONT_URL=http://localhost:5174
# Admin app URL: ECPay returns here for orders placed in its customer store; email-verification links point here
ADMIN_STORE_URL=http://localhost:5173

# --- Orders: cancel unpaid ECPay storefront orders after N hours (0 = never) ---
ORDER_UNPAID_TIMEOUT_HOURS=72
# ECPay ATM / convenience-store code payment deadline in days (keep shorter than the timeout above)
ECPAY_EXPIRE_DAYS=2

# --- Emails: order notifications + member email verification (disabled when SPRING_MAIL_HOST is unset) ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=
STORE_NAME=遇日小舖

# --- Files ---
FILE_UPLOAD_DIR=./uploads/images

# --- ECPay (defaults below are ECPay's public stage test merchant) ---
ECPAY_MERCHANT_ID=2000132
ECPAY_HASH_KEY=5294y06JbISpM5x9
ECPAY_HASH_IV=v77hoKGq4kWxNNIS
ECPAY_API_URL=https://payment-stage.ecpay.com.tw
ECPAY_RETURN_URL=http://localhost:5173/payment/result
# Must be reachable from the internet (use ngrok etc. in development)
ECPAY_NOTIFY_URL=http://localhost:8080/api/payment-gateway/callback/ecpay
ECPAY_SANDBOX=true

# --- LINE Pay (optional) ---
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET=
LINEPAY_SANDBOX=true
